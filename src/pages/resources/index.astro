---
import SiteLayout from '../../layouts/SiteLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import { listResources } from '../../lib/server/content';
const resources = listResources();
const purchasedIds = ['cnki', 'ncpssd', 'chaoxing-digital-books', 'duxiu', 'emerald', 'met-english', 'yinfu-remote', 'yinfu-local', 'guoyan', 'youyue-foreign-books'];
const trialIds = ['trial-pkulaw', 'trial-legacy-715', 'trial-wiley-online-library', 'trial-legacy-738', 'trial-legacy-740', 'trial-legacy-672', 'trial-zhiyuebook', 'trial-legacy-677'];
const openAccessIds = ['open-gdlll', 'open-sinoconf', 'open-napstic-journals', 'open-national-laws', 'open-nstrs', 'open-chinese-film', 'open-elderly-education', 'open-nlc-course', 'open-republic-local-docs', 'open-republic-docs', 'open-ancient-books', 'open-yongle', 'open-hanspub', 'open-icourse163', 'open-ndlib', 'open-netease', 'open-plos', 'open-bmc', 'open-pmc', 'open-arxiv', 'open-doaj', 'open-intangible-culture', 'open-guangdong-culture', 'open-dongguan-training'];
const orderResources = (items: typeof resources, preferredIds: string[]) => {
  const preferredOrder = new Map(preferredIds.map((id, index) => [id, index]));
  return [...items].sort((a, b) => {
    const aOrder = preferredOrder.get(a.id);
    const bOrder = preferredOrder.get(b.id);
    if (aOrder !== undefined || bOrder !== undefined) return (aOrder ?? Number.MAX_SAFE_INTEGER) - (bOrder ?? Number.MAX_SAFE_INTEGER);
    return a.name.localeCompare(b.name, 'zh-CN');
  });
};
const collectionResources = orderResources(resources.filter((resource) => !['试用数据库', '开放资源'].includes(resource.category)), purchasedIds);
const trialResources = orderResources(resources.filter((resource) => resource.category === '试用数据库'), trialIds);
const openAccessResources = orderResources(resources.filter((resource) => resource.category === '开放资源'), openAccessIds);
const collectionCategories = ['全部', ...new Set(collectionResources.map((item) => item.category))];
---
<SiteLayout title="电子资源" description="数据库、电子图书与开放学术资源" active="resources">
  <InnerHero eyebrow="ELECTRONIC RESOURCES" title="电子资源" description="一站式发现中外文数据库、电子图书、考试学习与开放获取资源。" icon="database" />
  <section class="inner-section page-shell resource-directory-section">
    <div class="resource-search resource-search-wide"><span class="material-symbols-outlined">search</span><input type="search" placeholder="搜索馆藏数据库、试用数据库或开放获取资源" aria-label="搜索全部电子资源" /></div>

    <div class="resource-directory">
      <section class="resource-column collection-resource-column" aria-labelledby="collection-resource-title">
        <header class="resource-column-header">
          <div class="resource-column-title"><span class="material-symbols-outlined">account_balance</span><div><span>LIBRARY COLLECTION</span><h2 id="collection-resource-title">馆藏数据库</h2></div></div>
          <p><strong data-collection-count>{collectionResources.length}</strong> 项资源</p>
        </header>
        <p class="resource-column-intro">图书馆已购买、面向师生提供服务的电子资源。</p>
        <div class="filter-bar resource-filter-bar" aria-label="筛选馆藏数据库">{collectionCategories.map((category, index) => <button class:list={{ active: index === 0 }} data-resource-filter={category}>{category}</button>)}</div>
        <div class="resource-cards collection-resource-cards" data-resource-list="collection">{collectionResources.map((resource) => <article class="resource-card" data-resource-group="collection" data-category={resource.category} data-name={`${resource.name} ${resource.description}`.toLowerCase()}>
          <div class="resource-card-head"><span class="material-symbols-outlined">library_books</span><span class:list={['access-pill', resource.access === '公开' && 'open']}>{resource.access}</span></div>
          <span class="resource-category">{resource.category}</span><h3>{resource.name}</h3><p>{resource.description}</p>
          <a href={resource.url}>访问资源<span class="material-symbols-outlined">open_in_new</span></a>
        </article>)}</div>
        <p class="resource-empty" data-resource-empty="collection" hidden>没有找到符合条件的馆藏数据库。</p>
      </section>

      <aside class="resource-column trial-resource-column" aria-labelledby="trial-resource-title">
        <header class="resource-column-header trial-column-header">
          <div class="resource-column-title"><span class="material-symbols-outlined">experiment</span><div><span>TRIAL ACCESS</span><h2 id="trial-resource-title">试用数据库</h2></div></div>
          <p><strong data-trial-count>{trialResources.length}</strong> 项资源</p>
        </header>
        <p class="resource-column-intro">数据库试用权限和期限可能调整，请以资源平台及图书馆最新通知为准。</p>
        <div class="resource-cards trial-resource-cards" data-resource-list="trial">{trialResources.map((resource) => <article class="resource-card trial-resource-card" data-resource-group="trial" data-name={`${resource.name} ${resource.description}`.toLowerCase()}>
          <div class="resource-card-head"><span class="material-symbols-outlined">science</span><span class:list={['access-pill', resource.access === '公开' && 'open']}>{resource.access}</span></div>
          <span class="resource-category">试用数据库</span><h3>{resource.name}</h3><p>{resource.description}</p>
          <a href={resource.url}>访问试用<span class="material-symbols-outlined">open_in_new</span></a>
        </article>)}</div>
        <p class="resource-empty trial-resource-empty" data-resource-empty="trial" hidden>没有找到符合条件的试用数据库。</p>
      </aside>

      <aside class="resource-column open-access-resource-column" aria-labelledby="open-access-resource-title">
        <header class="resource-column-header open-access-column-header">
          <div class="resource-column-title"><span class="material-symbols-outlined">public</span><div><span>OPEN ACCESS</span><h2 id="open-access-resource-title">开放获取资源</h2></div></div>
          <p><strong data-open-access-count>{openAccessResources.length}</strong> 项资源</p>
        </header>
        <p class="resource-column-intro">无需购买权限即可访问的公共学术、文化与学习资源。</p>
        <div class="resource-cards open-access-resource-cards" data-resource-list="open-access">{openAccessResources.map((resource) => <article class="resource-card compact-resource-card" data-resource-group="open-access" data-name={`${resource.name} ${resource.description}`.toLowerCase()}>
          <div class="resource-card-head"><span class="material-symbols-outlined">language</span><span class="access-pill open">公开</span></div>
          <span class="resource-category">开放获取</span><h3>{resource.name}</h3><p>{resource.description}</p>
          <a href={resource.url}>访问资源<span class="material-symbols-outlined">open_in_new</span></a>
        </article>)}</div>
        <p class="resource-empty open-access-resource-empty" data-resource-empty="open-access" hidden>没有找到符合条件的开放获取资源。</p>
      </aside>
    </div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('.resource-search input');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-resource-filter]');
    const collectionCards = [...document.querySelectorAll<HTMLElement>('[data-resource-group="collection"]')];
    const trialCards = [...document.querySelectorAll<HTMLElement>('[data-resource-group="trial"]')];
    const openAccessCards = [...document.querySelectorAll<HTMLElement>('[data-resource-group="open-access"]')];
    const collectionCount = document.querySelector<HTMLElement>('[data-collection-count]');
    const trialCount = document.querySelector<HTMLElement>('[data-trial-count]');
    const openAccessCount = document.querySelector<HTMLElement>('[data-open-access-count]');
    const collectionEmpty = document.querySelector<HTMLElement>('[data-resource-empty="collection"]');
    const trialEmpty = document.querySelector<HTMLElement>('[data-resource-empty="trial"]');
    const openAccessEmpty = document.querySelector<HTMLElement>('[data-resource-empty="open-access"]');
    let category = '全部';
    const update = () => {
      const query = (input?.value || '').trim().toLowerCase();
      let visibleCollection = 0;
      let visibleTrial = 0;
      let visibleOpenAccess = 0;
      collectionCards.forEach((card) => {
        const matchesCategory = category === '全部' || card.dataset.category === category;
        const visible = matchesCategory && (card.dataset.name || '').includes(query);
        card.hidden = !visible;
        if (visible) visibleCollection += 1;
      });
      trialCards.forEach((card) => {
        const visible = (card.dataset.name || '').includes(query);
        card.hidden = !visible;
        if (visible) visibleTrial += 1;
      });
      openAccessCards.forEach((card) => {
        const visible = (card.dataset.name || '').includes(query);
        card.hidden = !visible;
        if (visible) visibleOpenAccess += 1;
      });
      if (collectionCount) collectionCount.textContent = String(visibleCollection);
      if (trialCount) trialCount.textContent = String(visibleTrial);
      if (openAccessCount) openAccessCount.textContent = String(visibleOpenAccess);
      if (collectionEmpty) collectionEmpty.hidden = visibleCollection !== 0;
      if (trialEmpty) trialEmpty.hidden = visibleTrial !== 0;
      if (openAccessEmpty) openAccessEmpty.hidden = visibleOpenAccess !== 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.resourceFilter || '全部'; buttons.forEach((item) => item.classList.remove('active')); button.classList.add('active'); update(); }));
    input?.addEventListener('input', update);
  </script>
</SiteLayout>
