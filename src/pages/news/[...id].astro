---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getArticle, renderArticleContent } from '../../lib/server/content';
const article = getArticle(Astro.params.id || '');
if (!article) return new Response('Not found', { status: 404 });
const renderedContent = renderArticleContent(article.content);
---
<SiteLayout title={article.title} description={article.summary} active="news">
  <div class="page-shell breadcrumb"><a href="/">首页</a><span>›</span><a href="/news/">新闻公告</a><span>›</span><span>{article.category}</span></div>
  <article class="article-detail page-shell">
    <header><span class="detail-category">{article.category}</span><h1>{article.title}</h1><div class="detail-meta"><time datetime={article.date}>{article.date}</time><span>东莞城市学院图书馆</span></div><p class="lead">{article.summary}</p></header>
    {article.cover && <img class="detail-cover" src={article.cover} alt="" />}
    <div class="prose" set:html={renderedContent}></div>
    {article.sourceUrl && <p class="legacy-source">原文存档：<a href={article.sourceUrl}>查看旧站页面</a></p>}
    <a class="back-link" href="/news/"><span class="material-symbols-outlined">arrow_back</span>返回新闻公告</a>
  </article>
</SiteLayout>
