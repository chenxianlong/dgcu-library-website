---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listResources } from '../../../lib/server/content';
const resources = listResources(true);
const resourceGroups = [
  { title: '馆藏数据库', description: '正式馆藏的数据库、电子图书及考试学习资源。', items: resources.filter((item) => !['试用数据库', '开放资源'].includes(item.category)) },
  { title: '试用数据库', description: '当前或历史试用资源，可通过发布状态控制是否在前台展示。', items: resources.filter((item) => item.category === '试用数据库') },
  { title: '开放获取资源', description: '无需购买权限即可访问的公共学术、文化与学习资源。', items: resources.filter((item) => item.category === '开放资源') },
];
const saved = Astro.url.searchParams.get('saved');
---
<AdminLayout title="电子资源" active="resources">
  <div class="page-title"><div><h1>电子资源</h1><p>分为馆藏数据库、试用数据库和开放获取资源，保存后前台自动同步。</p></div><a class="primary-button" href="/admin/resources/new/"><span class="material-symbols-outlined">add</span>新建资源</a></div>
  {saved && <p class="form-message">资源已保存。</p>}
  {resourceGroups.map((group) => <section class="admin-panel resource-admin-group">
    <div class="panel-header"><div><h2>{group.title}</h2><p>{group.description}</p></div><span>{group.items.length} 项</span></div>
    <table class="admin-table"><thead><tr><th>资源名称</th><th>细分类</th><th>访问方式</th><th>状态</th><th>操作</th></tr></thead><tbody>
      {group.items.map(item=><tr><td><a class="title-link" href={`/admin/resources/${item.id}/`}>{item.name}</a></td><td>{['试用数据库','开放资源'].includes(item.category) ? '—' : item.category}</td><td>{item.access}</td><td><span class:list={['status-pill',item.status]}>{item.status === 'published' ? '已发布' : item.status === 'draft' ? '草稿' : '已归档'}</span></td><td><a href={`/admin/resources/${item.id}/`}>编辑</a></td></tr>)}
    </tbody></table>
  </section>)}
</AdminLayout>
