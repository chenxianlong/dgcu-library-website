---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const { title, description = '东莞城市学院图书馆', active = '' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} /><meta name="theme-color" content="#0b683f" />
    <link rel="icon" href="/images/favicon.ico" type="image/png" />
    <title>{title}｜东莞城市学院图书馆</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a><SiteHeader active={active} />
    <main id="main"><slot /></main><SiteFooter />
  </body>
</html>
