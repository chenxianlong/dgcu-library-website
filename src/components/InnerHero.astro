---
const { eyebrow = 'DGCU LIBRARY', title, description, icon = 'auto_stories' } = Astro.props;
---
<section class="inner-hero"><div class="page-shell inner-hero-grid"><div><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{description}</p></div><span class="material-symbols-outlined inner-hero-icon" aria-hidden="true">{icon}</span></div></section>
