---
import 'easymde/dist/easymde.min.css';

interface Props {
  value?: string;
  csrfToken: string;
}

const { value = '', csrfToken } = Astro.props;
---

<div class="markdown-editor-shell" data-markdown-editor data-csrf={csrfToken}>
  <textarea id="content" name="content" aria-label="正文 Markdown 源码" required>{value}</textarea>
  <input class="sr-only" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple data-editor-image-input />
  <div class="markdown-editor-help">
    <span><span class="material-symbols-outlined" aria-hidden="true">info</span>图片会插入到当前光标位置；选中文字后可设置居中或右对齐。</span>
    <span data-upload-status aria-live="polite"></span>
  </div>
</div>

<script>
  import EasyMDE from 'easymde';
  import { renderMarkdown } from '../../lib/markdown';

  type CodeMirrorPosition = { line: number; ch: number };
  type EditorToolbarButton = {
    name: string;
    action: (editor: EasyMDE) => void;
    className: string;
    title: string;
  };

  const insertAlignment = (editor: EasyMDE, position: 'center' | 'right') => {
    const cm = editor.codemirror;
    const selected = cm.getSelection();
    const cursor = cm.getCursor();
    const line = cm.getLine(cursor.line);
    const content = selected || line || (position === 'right' ? '落款' : '居中文字');
    const replacement = `{% align position="${position}" %}\n\n${content}\n\n{% /align %}`;
    if (selected) {
      cm.replaceSelection(replacement);
    } else if (line) {
      cm.replaceRange(replacement, { line: cursor.line, ch: 0 }, { line: cursor.line, ch: line.length });
    } else {
      cm.replaceSelection(replacement);
    }
    cm.focus();
  };

  const translatedTitles: Record<string, string> = {
    Bold: '粗体', Italic: '斜体', Heading: '标题', Quote: '引用',
    'Generic List': '无序列表', 'Numbered List': '有序列表',
    'Create Link': '插入链接', 'Insert Table': '插入表格',
    'Insert Horizontal Line': '插入分隔线', Preview: '预览', 'Toggle Preview': '预览',
    'Side-by-Side Mode': '分栏预览', 'Toggle Side by Side': '分栏预览',
    'Toggle Fullscreen': '全屏编辑', Guide: 'Markdown 帮助', 'Markdown Guide': 'Markdown 帮助',
  };

  document.querySelectorAll<HTMLElement>('[data-markdown-editor]').forEach((shell) => {
    const textarea = shell.querySelector<HTMLTextAreaElement>('textarea[name="content"]');
    const imageInput = shell.querySelector<HTMLInputElement>('[data-editor-image-input]');
    const uploadStatus = shell.querySelector<HTMLElement>('[data-upload-status]');
    const form = shell.closest<HTMLFormElement>('form');
    if (!textarea || !imageInput || !uploadStatus || !form) return;

    const imageButton: EditorToolbarButton = {
      name: 'upload-image-at-cursor',
      action: () => imageInput.click(),
      className: 'fa fa-picture-o editor-upload-image',
      title: '上传图片到光标位置',
    };
    const alignCenterButton: EditorToolbarButton = {
      name: 'align-center',
      action: (editor) => insertAlignment(editor, 'center'),
      className: 'fa fa-align-center',
      title: '居中对齐',
    };
    const alignRightButton: EditorToolbarButton = {
      name: 'align-right',
      action: (editor) => insertAlignment(editor, 'right'),
      className: 'fa fa-align-right',
      title: '右对齐（适合落款）',
    };

    const editor = new EasyMDE({
      element: textarea,
      autofocus: false,
      forceSync: true,
      minHeight: '460px',
      placeholder: '使用 Markdown 编写正文……',
      previewRender: (markdown) => renderMarkdown(markdown),
      promptURLs: true,
      sideBySideFullscreen: false,
      spellChecker: false,
      status: ['lines', 'words', 'cursor'],
      toolbar: [
        'bold', 'italic', 'heading', '|',
        'quote', 'unordered-list', 'ordered-list', '|',
        'link', imageButton, 'table', 'horizontal-rule', '|',
        alignCenterButton, alignRightButton, '|',
        'preview', 'side-by-side', 'fullscreen', '|', 'guide',
      ],
    });

    shell.querySelectorAll<HTMLElement>('.editor-toolbar button, .editor-toolbar a').forEach((button) => {
      const current = button.getAttribute('title') || button.getAttribute('aria-label');
      if (current && translatedTitles[current]) {
        button.setAttribute('title', translatedTitles[current]);
        button.setAttribute('aria-label', translatedTitles[current]);
      }
    });

    imageInput.addEventListener('change', async () => {
      const files = Array.from(imageInput.files || []);
      if (!files.length) return;
      const cm = editor.codemirror;
      let insertionPoint: CodeMirrorPosition = cm.getCursor();
      uploadStatus.textContent = `正在上传 0 / ${files.length}…`;
      uploadStatus.classList.remove('is-error');
      imageInput.disabled = true;

      try {
        for (let index = 0; index < files.length; index += 1) {
          const file = files[index];
          const data = new FormData();
          data.set('csrf', shell.dataset.csrf || '');
          data.set('image', file);
          const response = await fetch('/admin/api/uploads/image', { method: 'POST', body: data });
          const result = await response.json() as { path?: string; error?: string };
          if (!response.ok || !result.path) throw new Error(result.error || '图片上传失败');
          const alt = file.name.replace(/\.[^.]+$/, '').replace(/[\[\]]/g, '') || '正文图片';
          const markdown = `${insertionPoint.ch ? '\n\n' : ''}![${alt}](${result.path})\n\n`;
          cm.replaceRange(markdown, insertionPoint);
          const lines = markdown.split('\n');
          insertionPoint = {
            line: insertionPoint.line + lines.length - 1,
            ch: lines.length === 1 ? insertionPoint.ch + markdown.length : lines.at(-1)?.length || 0,
          };
          uploadStatus.textContent = `正在上传 ${index + 1} / ${files.length}…`;
        }
        cm.setCursor(insertionPoint);
        cm.focus();
        uploadStatus.textContent = `已在光标位置插入 ${files.length} 张图片`;
      } catch (error) {
        uploadStatus.textContent = error instanceof Error ? error.message : '图片上传失败';
        uploadStatus.classList.add('is-error');
      } finally {
        imageInput.disabled = false;
        imageInput.value = '';
      }
    });

    form.addEventListener('submit', (event) => {
      textarea.value = editor.value().trim();
      if (textarea.value) return;
      event.preventDefault();
      editor.codemirror.focus();
      shell.classList.add('has-error');
    });
  });
</script>
